# Keep binary project/reference documents out of textual diffs.
*.pdf binary
*.dwg binary
*.dxf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.tar binary
*.gz binary
*.deb binary

# Normalize source and documentation line endings for Linux containers.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
