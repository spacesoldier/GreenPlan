# Obtained by the operator; do not point this at the DEB itself.
ODA_RUNTIME_HOST_DIR=/absolute/path/to/extracted/usr/bin/ODAFileConverter_27.1.0.0
POSTGRES_PORT=35483
POSTGRES_DB=greenplan
POSTGRES_USER=greenplan
POSTGRES_PASSWORD=replace-before-shared-use
POSTGIS_PORT=36483
POSTGIS_DB=greenplan_domain
POSTGIS_USER=greenplan_domain
POSTGIS_PASSWORD=replace-before-shared-use
API_PORT=38100
WEB_PORT=38101
ODA_TIMEOUT=900
WORK_ROOT_HOST_DIR=/tmp/greenplan-cad-work
LIBREDWG_KEEP_JSON=false
WORK_KEEP_INPUT=false
LIBREDWG_VERSION=0.14
ARCHIVE_ROOT_HOST_DIR=/tmp/greenplan-archive-extracted-sol
LOCAL_UID=1000
LOCAL_GID=1000
# Optional Jev-compatible Laya decision endpoint, for example http://laya:8000.
# Without it, explainable deterministic rules remain active.
LAYA_URL=
LAYA_API_KEY=
